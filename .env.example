# Keep this file private. It is already in .gitignore. Never upload it to GitHub.

# Root admin account (created on first start; after you change the password in
# the portal's Account page, this value no longer overrides it)
ADMIN_EMAIL=nettech.management@gmail.com
ADMIN_PASSWORD=choose-a-strong-password

# Random secret for login tokens (already generated for you)
JWT_SECRET=replace-with-a-long-random-string

# Public address of the site. For local testing keep this. After deploying, use your live address,
# e.g. https://nettech.onrender.com (no trailing slash)
APP_URL=http://localhost:5173

# ---- Permanent data storage (free Postgres from neon.com) ----
# Leave empty while testing on your computer (data is saved in server/db.json).
# REQUIRED on free hosting, otherwise your data is erased when the server restarts.
DATABASE_URL=

# ---- Email notifications (Gmail) ----
# FREE HOSTING (Render free blocks SMTP): use the free Gmail relay in tools/gmail-relay.gs, then fill these two:
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
# ON YOUR OWN COMPUTER (or a paid host): SMTP also works. Create a Gmail App Password and fill SMTP_PASS.
# Google Account > Security > 2-Step Verification > App passwords, paste the 16 characters (no spaces)
SMTP_USER=nettech.management@gmail.com
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=nettech.management@gmail.com

# ---- Card payments: Paystack (works with South African businesses, ZAR) ----
PAYMENT_PROVIDER=paystack
# Paystack Dashboard > Settings > API Keys & Webhooks. Start with the TEST secret key (sk_test_...)
PAYSTACK_SECRET_KEY=
# Default invoice currency: zar, usd, eur, gbp (your Paystack account must support the currency)
CURRENCY=zar

# ---- Only if you ever switch to Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
